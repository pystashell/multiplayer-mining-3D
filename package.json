{
  "name": "3d-multiplayer-mining",
  "version": "4.1.0",
  "description": "A local-first 3D minesweeper campaign with an optional web multiplayer mode.",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "vendor:sync": "node scripts/sync-vendor-assets.mjs",
    "vendor:check": "node scripts/sync-vendor-assets.mjs --check",
    "version": "node scripts/sync-release-version.mjs",
    "version:check": "node scripts/check-release.mjs",
    "release:check": "node scripts/check-release.mjs",
    "test:catalog": "node scripts/generate-test-catalog.mjs",
    "test:catalog:check": "node scripts/generate-test-catalog.mjs --check",
    "ui:manual": "node scripts/generate-ui-manual.mjs",
    "ui:manual:check": "node scripts/generate-ui-manual.mjs --check",
    "ui:approve": "node scripts/record-ui-approval.mjs",
    "ui:check": "node scripts/check-ui-approval.mjs",
    "test": "npm run test:catalog:check && npm run ui:manual:check && npm run vendor:check && npm run version:check && node --test tests/*.test.js",
    "test:live": "node tests/live-room-smoke.js",
    "verify:live-version": "node scripts/verify-live-version.mjs",
    "deploy:dry": "wrangler deploy --dry-run",
    "predeploy": "npm test && npm run deploy:dry && npm run ui:check",
    "deploy": "npm run predeploy && wrangler deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@fontsource/inter": "5.2.8",
    "@fontsource/orbitron": "5.2.8",
    "@fontsource/share-tech-mono": "5.2.7",
    "three": "0.150.0",
    "wrangler": "4.110.0"
  }
}
